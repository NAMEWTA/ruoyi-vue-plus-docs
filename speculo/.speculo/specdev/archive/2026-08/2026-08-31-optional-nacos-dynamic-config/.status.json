  "deviations": [
    {
      "ticket_id": "T-01",
      "kind": "runtime-snapshot-contract",
      "observed_at": "2026-09-01T10:08:00+08:00",
      "detail": "The Nacos 2.5.4 Java client enables local snapshots by default, which conflicted with the locked offline-restart contract.",
      "impact": "Without an explicit SDK switch, an offline process restart could consume stale remote state instead of the complete local YAML baseline.",
      "correction": "The client factory now disables Nacos snapshots before client construction, with a focused regression test; T-01 evidence records the forward correction commit."
    },
    {
      "ticket_id": "T-03",
      "kind": "fresh-database-charset",
      "observed_at": "2026-09-01T10:18:00+08:00",
      "detail": "A fresh MySQL 8.4 initialization exposed that five application SQL sources did not establish utf8mb4 before Chinese literals were parsed.",
      "impact": "The isolated full-stack database bootstrap failed before Nacos or the application could start; existing initialized databases were unaffected.",
      "correction": "SET NAMES utf8mb4 was added to every affected source SQL and the release contract test now verifies all six initialization sources."
    },
    {
      "ticket_id": "T-02",
      "kind": "startup-validation-order",
      "observed_at": "2026-09-01T10:31:00+08:00",
      "detail": "A cross-field-invalid remote document could be accepted during early startup before live-refresh participants had registered.",
      "impact": "The candidate could poison the initial in-memory baseline even though the same update was rejected after startup.",
      "correction": "Candidate validation now performs the locked notification-window and OSS-TTL cross-field checks against the effective local fallback before participant validation."
    },
    {
      "ticket_id": "T-06",
      "kind": "e2e-readiness-probe",
      "observed_at": "2026-09-01T10:39:00+08:00",
      "detail": "The initial harness used aggregate Actuator health, while optional OSS readiness is intentionally unavailable in the isolated Nacos matrix.",
      "impact": "Healthy application processes were reported as unavailable even though the Compose service contract is TCP readiness.",
      "correction": "The harness readiness probe was aligned with the shipped Compose TCP contract; behavioral assertions remained unchanged."
    },
    {
      "ticket_id": "T-06",
      "kind": "e2e-port-stability",
      "observed_at": "2026-09-01T10:46:00+08:00",
      "detail": "Docker-assigned ephemeral host ports changed after the required application stop/start phase.",
      "impact": "The harness retained an obsolete endpoint and could not distinguish restart convergence from port reassignment.",
      "correction": "The harness now reserves free loopback ports and binds them explicitly for the complete test lifetime; all restart and fault predicates are unchanged."
    }
  ],
