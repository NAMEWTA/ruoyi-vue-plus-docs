  "deviations": [
    {
      "ticket_id": "T-01",
      "kind": "test-scope-contract",
      "observed_at": "2026-08-31T23:50:00+08:00",
      "detail": "Requiring every uploadPolicy to declare storageConfigKey and expectedAccessPolicy necessarily invalidates the existing legal fixture in OssUploadConfigurationUnitTest, but that test file was omitted from the original writable paths.",
      "impact": "Without updating the existing binding fixture, the affected OSS configuration regression suite would fail for a planned contract change; no production ownership boundary changes.",
      "correction": "T-01 writable and expected paths now include only the existing OssUploadConfigurationUnitTest fixture; shared production ownership, external behavior and all downstream Ticket paths remain unchanged."
    },
    {
      "ticket_id": "T-02",
      "kind": "architecture-carrier-allowlist",
      "observed_at": "2026-09-01T00:46:00+08:00",
      "detail": "The existing business OSS carrier ratchet discovers OSS-named migration governance primary keys, batch foreign keys and migration object keys as candidate business-owned reference carriers.",
      "impact": "Without explicit infrastructure allowlist reasons, the affected OSS regression suite fails even though the new tables do not represent business Owner carriers.",
      "correction": "T-02 writable paths now include business-oss-owners.json and register four precisely scoped migration-infrastructure coordinates while unknown business carriers remain fail-closed."
    },
    {
      "ticket_id": "T-04",
      "kind": "typed-error-path-contract",
      "observed_at": "2026-09-01T01:45:00+08:00",
      "detail": "The locked T-04 contract requires stable typed OSS failures for access resolution, but the existing OssLifecycleError enum was omitted from expected and writable paths.",
      "impact": "Without extending the existing enum, access failures would use ambiguous generic exceptions or require a duplicate error hierarchy; external URL behavior is unchanged.",
      "correction": "T-04 expected and writable paths now include only OssLifecycleError.java so access resolution can reuse the existing lifecycle exception type."
    },
    {
      "ticket_id": "T-07",
      "kind": "runtime-openapi-prerequisite",
      "observed_at": "2026-09-01T03:25:00+08:00",
      "detail": "The integrated backend fixed commit cannot start its Spring context because OssStorageReadinessRegistry exposes two constructors without selecting the production injection constructor; direct-construction unit tests did not cover this runtime path.",
      "impact": "The required /v3/api-docs snapshot cannot be fetched from a truthful fixed backend commit, and the same defect would block the T-08 release runtime.",
      "correction": "T-07 writable paths include only the registry constructor marker, its existing unit test and the public access response nullability annotation for a minimal backend prerequisite checkpoint; OSS readiness and URL behavior remain unchanged."
    },
    {
      "ticket_id": "T-03",
      "kind": "runtime-readiness-renewal",
      "observed_at": "2026-09-01T04:43:07+08:00",
      "detail": "The readiness registry expires snapshots after five minutes, while refresh is currently triggered only at application startup and after OSS configuration changes.",
      "impact": "A healthy unchanged deployment eventually marks every required OSS configuration STALE and rejects upload, access resolution and migration until restart or an unrelated configuration update.",
      "correction": "Reopen T-03 to add bounded periodic snapshot renewal within the existing readiness ownership boundary, prove the scheduling contract and configuration invariants, then rerun T-03 and T-08 candidate gates."
    }
  ],
